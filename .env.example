# Environment Configuration Template
# Copy to .env for local overrides (never commit real credentials)

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Database Persistence
DATABASE_URL=sqlite:///./image_matching.db

# Optional: Cloud Vision & Embedding Providers (Free Tiers)
# If left empty, system uses high-performance deterministic local simulation
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Mismatch Guard Safety Thresholds
SIMILARITY_THRESHOLD=0.70
CONFIDENCE_THRESHOLD=0.75
